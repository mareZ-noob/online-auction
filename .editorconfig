root = true

# All Files (Global Settings)
[*]
indent_style = space
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
indent_size = 4

# Frontend: React, Vue, Angular, Standard Web (JS/TS Ecosystem)
[*.{js,jsx,ts,tsx,json,css,scss,less,html,vue}]
indent_size = 2

# Backend: Spring Boot (Java Ecosystem)
[*.{java,xml,properties,gradle}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Database files
[*.sql]
indent_size = 4

# Documentation & Scripts
[*.md]
trim_trailing_whitespace = false

[*.sh]
end_of_line = lf
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
